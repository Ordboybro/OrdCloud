* {
    font-family: "Segoe UI", Arial, sans-serif;
    color: #202631;
}

QMainWindow,
QWidget {
    background: #F4F6FA;
}

QFrame#leftMenu,
QFrame#rightSidebar,
QFrame#actionBar,
QFrame#statusBar,
QFrame#fileRow {
    background: #FFFFFF;
    border: 1px solid #E1E6EE;
}

QLabel#logo {
    color: #202631;
    font-size: 25px;
    font-weight: 800;
}

QPushButton#menuButton {
    background: transparent;
    border: none;
    border-radius: 12px;
    color: #697386;
    text-align: left;
    padding: 0 16px;
}

QPushButton#menuButton:hover {
    background: #EEF2F7;
    color: #202631;
}

QPushButton#menuButton:checked {
    background: #5F89FF;
    color: white;
}

QFrame#searchBox,
QPushButton#iconButton {
    background: #FFFFFF;
    border: 1px solid #DDE3EB;
    border-radius: 12px;
}

QFrame#searchBox QLineEdit {
    background: transparent;
    border: none;
}

QFrame#fileRow:hover {
    background: #F0F4F9;
}

QFrame#rightSidebar {
    border-radius: 22px;
}

QFrame#storageStats {
    background: #F5F7FA;
    border: 1px solid #E1E6EE;
    border-radius: 15px;
}

QPushButton {
    border: none;
    border-radius: 10px;
    padding: 8px 14px;
}

QScrollBar:vertical {
    background: transparent;
    width: 8px;
}

QScrollBar::handle:vertical {
    background: #C7CFDB;
    border-radius: 4px;
}

QDialog {
    background: #FFFFFF;
}

QDialog QLineEdit {
    background: #F5F7FA;
    border: 1px solid #D9E0E9;
    border-radius: 10px;
    padding: 10px;
}
