/* =========================================================
   ORDCLOUD — reference UI
   ========================================================= */

* {
    font-family: "Segoe UI", Arial, sans-serif;
    color: #E8ECF4;
}

QMainWindow, QWidget {
    background: #0D1219;
}

/* LEFT NAVIGATION */
QFrame#leftMenu {
    background: #151B24;
    border: 1px solid #252E3A;
    border-radius: 21px;
}

QLabel#logo {
    background: #10161E;
    color: #FFFFFF;
    font-size: 23px;
    font-weight: 800;
    letter-spacing: 2px;
    padding: 10px 12px;
}

QLabel#menuSection {
    color: #687589;
    font-size: 11px;
    font-weight: 700;
    padding: 4px 12px 5px;
}

QPushButton#menuButton {
    background: transparent;
    border: 1px solid transparent;
    border-radius: 10px;
    color: #A0AABC;
    text-align: left;
    padding: 0 12px;
    font-size: 13px;
    font-weight: 500;
    min-height: 38px;
}

QPushButton#menuButton:hover {
    background: #1D2632;
    color: #FFFFFF;
}

QPushButton#menuButton:checked {
    background: #5E88FF;
    border-color: #7097FF;
    color: #FFFFFF;
    font-weight: 600;
}

QLabel#storageLabel {
    color: #7E899B;
    font-size: 10px;
    padding: 8px 0 2px;
}

QProgressBar#storageProgress {
    background: #2B3442;
    border: none;
    border-radius: 3px;
    height: 5px;
}

QProgressBar#storageProgress::chunk {
    background: #5E88FF;
    border-radius: 3px;
}

/* TOP */
QFrame#topToolbar {
    background: transparent;
    border: none;
    min-height: 42px;
    max-height: 42px;
}

QPushButton#iconButton {
    background: #151C26;
    border: 1px solid #293442;
    border-radius: 12px;
    color: #9DA9BB;
    font-size: 17px;
    font-weight: 500;
}

QPushButton#iconButton:hover {
    background: #202A37;
    border-color: #435169;
    color: #FFFFFF;
}

QPushButton#iconButton:pressed {
    background: #29364A;
}

QFrame#searchBox {
    background: #151C26;
    border: 1px solid #293442;
    border-radius: 12px;
    min-height: 42px;
    max-height: 42px;
}

QFrame#searchBox QLabel {
    color: #7E8A9D;
    font-size: 17px;
}

QFrame#searchBox QLineEdit {
    background: transparent;
    border: none;
    color: #F3F6FA;
    padding: 3px 2px;
    font-size: 13px;
}

/* BREADCRUMBS */
QWidget#navigation QPushButton, QWidget#navigation QLabel {
    color: #7E899B;
    background: transparent;
    border: none;
    font-size: 12px;
}

/* ACTION BAR */
QFrame#actionBar {
    background: #151B24;
    border: 1px solid #252E3A;
    border-radius: 14px;
    min-height: 42px;
    max-height: 42px;
}

QFrame#actionBar QPushButton {
    background: transparent;
    color: #A1ACBD;
    border: none;
    border-radius: 8px;
    padding: 7px 11px;
    font-size: 12px;
}

QFrame#actionBar QPushButton:hover {
    background: #222C3A;
    color: #FFFFFF;
}

/* DASHBOARD */
QLabel#contentTitle {
    color: #FFFFFF;
    font-size: 15px;
    font-weight: 600;
}

QLabel#subTitle {
    color: #FFFFFF;
    font-size: 13px;
    font-weight: 600;
}

QFrame#quickCard {
    background: #151B24;
    border: 1px solid #27313E;
    border-radius: 13px;
    min-height: 62px;
    max-height: 62px;
}

QFrame#quickCard:hover {
    background: #1B2430;
    border-color: #40506A;
}

QLabel#quickIcon {
    background: #202936;
    border-radius: 9px;
    color: #D9E2F3;
    font-size: 18px;
    min-width: 36px;
    max-width: 36px;
    min-height: 36px;
    max-height: 36px;
}

QLabel#quickTitle {
    color: #E8ECF4;
    font-size: 12px;
    font-weight: 600;
}

QLabel#quickCount {
    color: #6F7B8E;
    font-size: 10px;
}

QPushButton#showAll {
    background: transparent;
    border: none;
    color: #648EFF;
    font-size: 11px;
}

QPushButton#showAll:hover {
    color: #8DABFF;
}

QFrame#recentTable {
    background: #151B24;
    border: 1px solid #252E3A;
    border-radius: 14px;
}

QFrame#recentHeader {
    background: transparent;
    border: none;
}

QFrame#recentHeader QLabel {
    color: #697588;
    font-size: 10px;
    padding: 2px 0;
}

QFrame#recentRow {
    background: #111720;
    border: 1px solid #1B2531;
    border-radius: 8px;
    min-height: 39px;
    max-height: 39px;
}

QFrame#recentRow:hover {
    background: #1B2430;
    border-color: #334156;
}

QLabel#recentIcon {
    color: #AFC0E1;
    font-size: 17px;
}

QLabel#recentName {
    color: #DCE3EE;
    font-size: 11px;
}

QLabel#recentMeta {
    color: #778398;
    font-size: 10px;
}

QPushButton#recentStar, QPushButton#recentMore {
    background: transparent;
    border: none;
    color: #788499;
    font-size: 14px;
}

QPushButton#recentStar:hover, QPushButton#recentMore:hover {
    color: #FFFFFF;
}

/* FILE EXPLORER */
QScrollArea, QScrollArea > QWidget > QWidget {
    background: transparent;
    border: none;
}

QFrame#fileRow {
    background: #151B24;
    border: 1px solid #202A36;
    border-radius: 12px;
}

QFrame#fileRow:hover {
    background: #1B2430;
    border-color: #35445B;
}

QLabel#fileIcon {
    min-width: 38px;
    max-width: 38px;
    font-size: 22px;
    color: #F5B53A;
}

QFrame#fileRow QLabel {
    color: #E8ECF3;
}

/* RIGHT */
QFrame#rightSidebar {
    background: transparent;
    border: none;
}

QFrame#storagePanel {
    background: transparent;
    border: none;
}

QLabel#sectionTitle {
    color: #FFFFFF;
    font-size: 13px;
    font-weight: 600;
}

QFrame#storageStats {
    background: transparent;
    border: none;
}

QFrame#storageStats QLabel {
    color: #A5AFBF;
    font-size: 11px;
}

QLabel#uploadTitle {
    color: #FFFFFF;
    font-size: 12px;
    font-weight: 600;
    padding-top: 2px;
}

QFrame#uploadBox {
    background: #111720;
    border: 1px dashed #3B485B;
    border-radius: 12px;
    min-height: 112px;
}

QFrame#uploadBox:hover {
    background: #17202C;
    border-color: #5E88FF;
}

QLabel#uploadIcon {
    color: #789AFF;
    font-size: 26px;
}

QLabel#uploadText {
    color: #BFC8D6;
    font-size: 11px;
}

QLabel#uploadHint {
    color: #697589;
    font-size: 10px;
}

QFrame#rightSidebar > QPushButton {
    background: #151C26;
    border: 1px solid #293442;
    border-radius: 10px;
    color: #7E899B;
    font-size: 11px;
    min-height: 36px;
}

QFrame#rightSidebar > QPushButton:hover {
    background: #202A37;
    color: #FFFFFF;
}

/* STATUS */
QFrame#statusBar {
    background: transparent;
    border: none;
    min-height: 22px;
    max-height: 22px;
}

QFrame#statusBar QLabel {
    color: #657184;
    font-size: 10px;
}

/* DIALOGS / MENUS */
QDialog {
    background: #151B24;
}

QDialog QLabel {
    color: #E8ECF3;
}

QDialog QLineEdit {
    background: #10161E;
    border: 1px solid #303A4A;
    border-radius: 9px;
    color: #FFFFFF;
    padding: 9px;
}

QMenu {
    background: #171E28;
    border: 1px solid #303B4C;
    border-radius: 9px;
    padding: 5px;
}

QMenu::item {
    padding: 7px 20px;
    border-radius: 6px;
}

QMenu::item:selected {
    background: #29364A;
}

QToolTip {
    background: #202936;
    color: #FFFFFF;
    border: 1px solid #39465A;
    padding: 5px;
}

QScrollBar:vertical {
    background: transparent;
    width: 7px;
    margin: 3px;
}

QScrollBar::handle:vertical {
    background: #303A49;
    border-radius: 4px;
    min-height: 28px;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
}
