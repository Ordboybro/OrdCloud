/* OrdCloud — polished dark storage dashboard */

* {
    font-family: "Segoe UI", Arial, sans-serif;
    color: #e8edf5;
}

QMainWindow, QWidget {
    background: #0b1017;
}

QFrame#leftMenu {
    background: #121821;
    border: 1px solid #202a38;
    border-radius: 16px;
}

QLabel#logo {
    background: transparent;
    color: #f5f7fb;
    font-size: 22px;
    font-weight: 800;
    letter-spacing: 2px;
    padding: 5px 7px;
}

QLabel#menuSection {
    color: #626f82;
    font-size: 10px;
    font-weight: 700;
    padding: 5px 8px 4px;
}

QPushButton#menuButton {
    background: transparent;
    border: 1px solid transparent;
    border-radius: 9px;
    color: #919daf;
    text-align: left;
    padding: 0 10px;
    font-size: 12px;
    font-weight: 500;
    min-height: 34px;
}

QPushButton#menuButton:hover {
    background: #1a2330;
    color: #f5f7fb;
}

QPushButton#menuButton:checked {
    background: #2b56d8;
    border-color: #3b65e3;
    color: #ffffff;
    font-weight: 600;
}

QLabel#storageLabel {
    color: #687588;
    font-size: 9px;
    padding: 7px 0 3px;
}

QProgressBar#storageProgress {
    background: #252e3b;
    border: none;
    border-radius: 3px;
    height: 5px;
}

QProgressBar#storageProgress::chunk {
    background: #557df1;
    border-radius: 3px;
}

QFrame#topToolbar {
    background: transparent;
    border: none;
    min-height: 40px;
    max-height: 40px;
}

QPushButton#iconButton {
    background: #121923;
    border: 1px solid #263140;
    border-radius: 10px;
    color: #929eb0;
    min-width: 34px;
    max-width: 34px;
    min-height: 34px;
    max-height: 34px;
    font-size: 19px;
    font-weight: 400;
}

QPushButton#iconButton:hover {
    background: #1b2532;
    border-color: #3a4a61;
    color: #ffffff;
}

QPushButton#iconButton:pressed {
    background: #243249;
}

QPushButton#profileButton {
    background: #e8edf5;
    color: #18202b;
    border-color: #e8edf5;
    font-size: 12px;
    font-weight: 700;
}

QPushButton#profileButton:hover {
    background: #ffffff;
    border-color: #ffffff;
    color: #111823;
}

QFrame#searchBox {
    background: #121923;
    border: 1px solid #263140;
    border-radius: 10px;
    min-height: 34px;
    max-height: 34px;
}

QFrame#searchBox QLabel {
    color: #667489;
    font-size: 14px;
}

QFrame#searchBox QLineEdit {
    background: transparent;
    border: none;
    color: #f1f4f8;
    padding: 2px 1px;
    font-size: 12px;
}

QWidget#navigation QPushButton,
QWidget#navigation QLabel {
    color: #69768a;
    background: transparent;
    border: none;
    font-size: 10px;
}

QFrame#actionBar {
    background: #121821;
    border: 1px solid #202a38;
    border-radius: 11px;
    min-height: 40px;
    max-height: 40px;
}

QFrame#actionBar QPushButton {
    background: transparent;
    color: #919daf;
    border: none;
    border-radius: 7px;
    padding: 6px 10px;
    font-size: 11px;
}

QFrame#actionBar QPushButton:hover {
    background: #202a38;
    color: #ffffff;
}

QLabel#contentTitle {
    color: #f8f9fc;
    font-size: 17px;
    font-weight: 650;
    padding-top: 1px;
}

QLabel#subTitle {
    color: #f1f4f8;
    font-size: 12px;
    font-weight: 600;
}

QFrame#quickCard {
    background: #121821;
    border: 1px solid #222c39;
    border-radius: 10px;
    min-height: 58px;
    max-height: 58px;
}

QFrame#quickCard:hover {
    background: #19222e;
    border-color: #35465e;
}

QLabel#quickIcon {
    background: #202936;
    border-radius: 8px;
    color: #dbe5f8;
    font-size: 17px;
    min-width: 32px;
    max-width: 32px;
    min-height: 32px;
    max-height: 32px;
}

QLabel#quickIcon[iconType="blue"] { color: #79a0ff; background: #19294a; }
QLabel#quickIcon[iconType="green"] { color: #68d0a3; background: #193229; }
QLabel#quickIcon[iconType="purple"] { color: #b18be7; background: #2b2340; }
QLabel#quickIcon[iconType="red"] { color: #ff7c84; background: #392329; }
QLabel#quickIcon[iconType="violet"] { color: #ae7be2; background: #2c2340; }

QLabel#quickTitle {
    color: #e3e9f2;
    font-size: 11px;
    font-weight: 600;
}

QLabel#quickCount {
    color: #687589;
    font-size: 9px;
}

QPushButton#showAll {
    background: transparent;
    border: none;
    color: #6c91ff;
    font-size: 10px;
}

QPushButton#showAll:hover { color: #9ab4ff; }

QFrame#recentTable {
    background: #121821;
    border: 1px solid #202a38;
    border-radius: 11px;
}

QFrame#recentHeader { background: transparent; border: none; }

QFrame#recentHeader QLabel {
    color: #657287;
    font-size: 9px;
    padding: 3px 0;
}

QFrame#recentRow {
    background: #10161e;
    border: 1px solid #1a2430;
    border-radius: 8px;
    min-height: 37px;
    max-height: 37px;
}

QFrame#recentRow:hover {
    background: #19222e;
    border-color: #314158;
}

QLabel#recentIcon { color: #aebddd; font-size: 15px; }
QLabel#recentName { color: #dce4ef; font-size: 10px; }
QLabel#recentMeta { color: #748197; font-size: 9px; }
QLabel#recentEmpty { color: #687589; font-size: 11px; padding: 28px; }

QPushButton#recentStar, QPushButton#recentMore {
    background: transparent;
    border: none;
    color: #718097;
    font-size: 12px;
}

QPushButton#recentStar:hover, QPushButton#recentMore:hover { color: #ffffff; }

QScrollArea, QScrollArea > QWidget > QWidget {
    background: transparent;
    border: none;
}

QFrame#fileRow {
    background: #121821;
    border: 1px solid #202a38;
    border-radius: 10px;
}

QFrame#fileRow:hover {
    background: #19222e;
    border-color: #35465e;
}

QLabel#fileIcon {
    min-width: 38px;
    max-width: 38px;
    font-size: 20px;
    color: #f0b24a;
}

QFrame#fileRow QLabel { color: #e5ebf3; }
QLabel#fileDate, QLabel#fileSize { color: #748197; font-size: 10px; }

QFrame#rightSidebar { background: transparent; border: none; }
QFrame#storagePanel { background: transparent; border: none; }
QLabel#sectionTitle { color: #f3f6fa; font-size: 13px; font-weight: 600; }
QFrame#storageStats { background: transparent; border: none; }
QFrame#storageStats QLabel { color: #919daf; font-size: 10px; }
QLabel#uploadTitle { color: #f3f6fa; font-size: 12px; font-weight: 600; padding-top: 1px; }

QFrame#uploadBox {
    background: #10161e;
    border: 1px dashed #354358;
    border-radius: 11px;
    min-height: 108px;
}

QFrame#uploadBox:hover { background: #17202c; border-color: #5c80ed; }
QLabel#uploadIcon { color: #7699f8; font-size: 25px; }
QLabel#uploadText { color: #bcc6d5; font-size: 10px; }
QLabel#uploadHint { color: #687589; font-size: 9px; }

QPushButton#upgradeButton {
    background: #557df1;
    border: 1px solid #6489f4;
    border-radius: 10px;
    color: #ffffff;
    font-size: 11px;
    font-weight: 600;
}

QPushButton#upgradeButton:hover { background: #648bf5; border-color: #7698f7; }
QPushButton#upgradeButton:pressed { background: #486ed8; }

QFrame#statusBar { background: transparent; border: none; min-height: 20px; max-height: 20px; }
QFrame#statusBar QLabel { color: #5f6d80; font-size: 9px; }

QDialog { background: #121821; }
QDialog QLabel { color: #e5ebf3; }
QDialog QLineEdit { background: #0f151d; border: 1px solid #303b4b; border-radius: 8px; color: #ffffff; padding: 8px; }
QDialog QPushButton { background: #1a2330; border: 1px solid #2d394a; border-radius: 8px; color: #dce4ef; padding: 7px 13px; }
QDialog QPushButton:hover { background: #243044; }

QMenu { background: #171f2a; border: 1px solid #303c4e; border-radius: 9px; padding: 5px; }
QMenu::item { padding: 7px 20px; border-radius: 6px; }
QMenu::item:selected { background: #29364a; }
QToolTip { background: #202936; color: #ffffff; border: 1px solid #39465a; padding: 5px; }

QScrollBar:vertical { background: transparent; width: 7px; margin: 3px; }
QScrollBar::handle:vertical { background: #303a49; border-radius: 4px; min-height: 28px; }
QScrollBar::handle:vertical:hover { background: #40506a; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
